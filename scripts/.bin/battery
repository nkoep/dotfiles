#!/bin/sh

set -o nounset

battery1=$(cat /sys/class/power_supply/BAT0/capacity 2>/dev/null)
battery2=$(cat /sys/class/power_supply/BAT1/capacity 2>/dev/null)

status1=$(cat /sys/class/power_supply/BAT0/status 2>/dev/null)
status2=$(cat /sys/class/power_supply/BAT1/status 2>/dev/null)

charging=0
if [ "$status1" = "Charging" ] || [ "$status2" = "Charging" ]; then
  status=" (charging)"
  charging=1
else
  status=""
fi

total=$((${battery1:-0} + ${battery2:-0}))

low_level=15
critical_level=5
low_flag=/tmp/battery-low-notified
critical_flag=/tmp/battery-critical-notified

if [ "$charging" -eq 1 ] || [ "$total" -gt "$low_level" ]; then
  rm -f "$low_flag" "$critical_flag"
elif [ "$total" -le "$critical_level" ]; then
  # Re-notify every run while critical so it can't be missed with a single
  # notification.
  notify-send -u critical "Battery critical (${total}%)" "Plug in now."
  touch "$low_flag" "$critical_flag"
elif [ ! -f "$low_flag" ]; then
  notify-send -u normal "Battery low (${total}%)" "Consider plugging in."
  touch "$low_flag"
fi

printf "%2d%% %2d%%${status}" "$battery1" "$battery2"
